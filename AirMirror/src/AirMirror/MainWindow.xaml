<Window x:Class="AirMirror.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AirMirror" Width="500" Height="820" MinWidth="420" MinHeight="500"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI" UseLayoutRounding="True">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20,16,20,20">

      <!-- Kopf -->
      <TextBlock Text="AirMirror" FontSize="26" FontWeight="SemiBold"/>
      <TextBlock Text="AirPlay-Empfänger für iPad &amp; iPhone" Foreground="{StaticResource SubText}" Margin="0,2,0,16"/>

      <!-- Status -->
      <Border Style="{StaticResource CardBorder}">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="{StaticResource SubText}" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusText" Text="Gestoppt" FontSize="18" FontWeight="SemiBold" Margin="10,0,0,0"/>
          </StackPanel>
          <TextBlock x:Name="StatusHint" TextWrapping="Wrap" Foreground="{StaticResource SubText}" Margin="22,6,0,14"
                     Text="Starte den Empfänger, um dein iPad zu spiegeln."/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="StartStopButton" Style="{StaticResource PrimaryButton}" Content="Empfänger starten" Click="StartStop_Click"/>
            <Button Grid.Column="2" x:Name="FullscreenButton" Content="⛶  Vollbild" Click="Fullscreen_Click" ToolTip="Vollbild ein/aus (auch im Tray-Menü)"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Warnungen -->
      <Border x:Name="WarningCard" Style="{StaticResource CardBorder}" Background="#3A2A12" Visibility="Collapsed">
        <StackPanel>
          <TextBlock Text="⚠  Hinweis" FontWeight="SemiBold" Foreground="#FFD60A"/>
          <TextBlock x:Name="WarningText" TextWrapping="Wrap" Margin="0,6,0,10" Foreground="#F5E6C8"/>
          <Button x:Name="FirewallButton" Content="Firewall-Freigabe einrichten (Admin)" HorizontalAlignment="Left" Click="Firewall_Click"/>
        </StackPanel>
      </Border>

      <!-- Empfänger-Einstellungen -->
      <Border Style="{StaticResource CardBorder}">
        <StackPanel>
          <TextBlock Text="Empfänger" FontSize="15" FontWeight="SemiBold"/>

          <TextBlock Style="{StaticResource Label}" Text="Name (so erscheint der PC auf dem iPad)"/>
          <TextBox x:Name="NameBox" TextChanged="Setting_Changed"/>

          <TextBlock Style="{StaticResource Label}" Text="Monitor"/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ComboBox x:Name="MonitorBox" SelectionChanged="Setting_Changed"/>
            <Button Grid.Column="2" Content="⟳" Padding="10,4" ToolTip="Monitore neu einlesen" Click="RefreshMonitors_Click"/>
          </Grid>

          <Grid Margin="0,0,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Style="{StaticResource Label}" Text="Auflösung"/>
              <ComboBox x:Name="ResolutionBox" SelectionChanged="Setting_Changed"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Style="{StaticResource Label}" Text="Max. Bildrate"/>
              <ComboBox x:Name="FpsBox" SelectionChanged="Setting_Changed"/>
            </StackPanel>
          </Grid>

          <TextBlock Style="{StaticResource Label}" Text="Video-Ausgabe"/>
          <ComboBox x:Name="SinkBox" SelectionChanged="Setting_Changed"/>

          <CheckBox x:Name="FullscreenCheck" Content="Vollbild auf dem gewählten Monitor" Margin="0,14,0,6" Click="Setting_Changed"/>
          <CheckBox x:Name="TopmostCheck" Content="Immer im Vordergrund" Click="Setting_Changed"/>
          <CheckBox x:Name="AudioCheck" Content="Ton über den PC ausgeben" Click="Setting_Changed"/>
          <CheckBox x:Name="H265Check" Content="H.265 / 4K erlauben (neuere iPads)" Click="Setting_Changed"/>
          <CheckBox x:Name="TakeoverCheck" Content="Neues Gerät darf laufende Verbindung übernehmen" Click="Setting_Changed"/>

          <TextBlock Style="{StaticResource Label}" Text="PIN (optional, 4 Ziffern – iPad muss sie eingeben)"/>
          <TextBox x:Name="PinBox" MaxLength="4" TextChanged="Setting_Changed"/>
        </StackPanel>
      </Border>

      <!-- App -->
      <Border Style="{StaticResource CardBorder}">
        <StackPanel>
          <TextBlock Text="App" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4"/>
          <CheckBox x:Name="AutostartCheck" Content="Mit Windows starten (im Tray)" Click="Setting_Changed"/>
          <CheckBox x:Name="AutoServerCheck" Content="Empfänger beim App-Start automatisch starten" Click="Setting_Changed"/>
          <TextBlock Style="{StaticResource Label}" Text="Zusätzliche UxPlay-Argumente (für Profis)"/>
          <TextBox x:Name="ExtraArgsBox" TextChanged="Setting_Changed" FontFamily="Cascadia Mono, Consolas"/>
          <TextBlock x:Name="EngineText" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,12,0,0"/>
        </StackPanel>
      </Border>

      <!-- Log -->
      <Expander Header="Protokoll" Foreground="{StaticResource Text}">
        <Grid Margin="0,8,0,0">
          <TextBox x:Name="LogBox" IsReadOnly="True" Height="220" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
          <Button Content="Kopieren" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,22,0" Padding="8,3" FontSize="11" Click="CopyLog_Click"/>
        </Grid>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</Window>
